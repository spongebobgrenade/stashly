  "executive_summary": {
    "problem": {
      "description": "People save large volumes of digital information across platforms but fail to retrieve it meaningfully later.",

      "sources": [
        "Instagram",
        "TikTok",
        "YouTube",
        "Safari",
        "screenshots",
        "PDFs",
        "notes",
        "products",
        "recipes",
        "articles",
        "videos",
        "files"
      ],

      "root_causes": [
        "saving is fragmented",
        "retrieval is weak",
        "organization is manual",
        "information becomes buried",
        "users forget where things were saved",
        "saved systems become digital graveyards"
      ]
    },

    "solution": {
      "description": "Stashly is an AI-assisted memory layer for a user's digital life.",

      "primary_flow": [
        "See something valuable",
        "Share to Stashly",
        "Forget about it",
        "Retrieve naturally later"
      ],

      "optimization_goals": [
        "memory recovery",
        "low cognitive effort",
        "retrieval confidence",
        "rediscovery",
        "contextual recall"
      ]
    }
  },

